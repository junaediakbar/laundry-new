DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true&statement_cache_size=0"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# WhatsApp notifications (Next.js server-side only)
# Must match FUNCTION_INTERNAL_TOKEN in Supabase Edge Function secrets.
SUPABASE_FUNCTION_INTERNAL_TOKEN="CHANGE_ME_RANDOM_LONG_STRING"

# Optional: restrict /whatsapp admin tools by email allowlist (comma-separated).
WHATSAPP_ADMIN_EMAILS="owner@yourdomain.com,admin@yourdomain.com"
