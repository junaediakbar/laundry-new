generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  owner
  admin
  cashier
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum WorkflowStatus {
  received
  washing
  drying
  ironing
  finished
  picked_up
}

enum WorkTaskType {
  pickup
  dropoff
  fuel_vehicle
  driver
  dust_removal
  brushing
  rinse_sprayer
  spin_dry
  finishing_packing
}

model User {
  id         String   @id @default(cuid())
  authUserId String   @unique @map("auth_user_id")
  name       String
  email      String   @unique
  role       Role
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workAssignments WorkAssignment[]

  @@index([name])
  @@map("employees")
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  address      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  email        String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]
  deliveryStops DeliveryStop[]

  @@index([name])
  @@map("customers")
}

model ServiceType {
  id          String   @id @default(cuid())
  name        String   @unique
  unit        String
  defaultPrice Decimal @db.Decimal(12, 2) @map("default_price")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  orders      Order[]
  items       OrderItem[]

  @@map("service_types")
}

model Order {
  id             String         @id @default(cuid())
  invoiceNumber  String         @unique @map("invoice_number")
  customerId     String         @map("customer_id")

  serviceTypeId  String?        @map("service_type_id")
  quantity       Decimal?       @db.Decimal(12, 2)
  unitPrice      Decimal?       @db.Decimal(12, 2) @map("unit_price")
  discount       Decimal?       @db.Decimal(12, 2) @default(0)
  total          Decimal        @db.Decimal(12, 2)
  paymentStatus  PaymentStatus  @default(unpaid) @map("payment_status")
  workflowStatus WorkflowStatus @default(received) @map("workflow_status")
  receivedDate   DateTime       @default(now()) @map("received_date")
  pickupDate     DateTime?      @map("pickup_date")
  note           String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceType  ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  payments     Payment[]
  items        OrderItem[]
  workAssignments WorkAssignment[]

  @@index([invoiceNumber])
  @@index([paymentStatus, workflowStatus])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  serviceTypeId String @map("service_type_id")

  quantity   Decimal  @db.Decimal(12, 2)
  unitPrice  Decimal  @db.Decimal(12, 2) @map("unit_price")
  discount   Decimal  @db.Decimal(12, 2) @default(0)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  workAssignments WorkAssignment[]

  @@index([orderId])
  @@index([serviceTypeId])
  @@map("order_items")
}

model WorkAssignment {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  orderItemId String      @map("order_item_id")
  employeeId String       @map("employee_id")
  taskType   WorkTaskType @map("task_type")
  percent    Decimal      @db.Decimal(5, 2)
  amount     Decimal      @db.Decimal(12, 2)
  createdAt  DateTime     @default(now()) @map("created_at")

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, taskType])
  @@index([orderId])
  @@index([employeeId])
  @@map("work_assignments")
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  paidAt    DateTime @default(now()) @map("paid_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model DeliveryPlan {
  id           String   @id @default(cuid())
  name         String
  plannedDate  DateTime @map("planned_date")
  startAddress String?  @map("start_address")
  startLat     Decimal? @db.Decimal(9, 6) @map("start_lat")
  startLng     Decimal? @db.Decimal(9, 6) @map("start_lng")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stops DeliveryStop[]

  @@index([plannedDate])
  @@map("delivery_plans")
}

model DeliveryStop {
  id        String       @id @default(cuid())
  planId    String       @map("plan_id")
  customerId String      @map("customer_id")
  sequence  Int
  distanceKm Decimal?    @db.Decimal(10, 2) @map("distance_km")
  createdAt DateTime     @default(now()) @map("created_at")

  plan     DeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([planId, customerId])
  @@unique([planId, sequence])
  @@index([customerId])
  @@map("delivery_stops")
}
